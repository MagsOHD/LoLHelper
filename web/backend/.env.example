# =====================================================================
# LoL Team Builder — configuration du backend (copiez ce fichier en .env)
# =====================================================================

# --- Clé API Riot (optionnelle) --------------------------------------
# Sans clé, l'application fonctionne en mode « manuel » : vous renseignez
# vous-même le pool de champions de chaque joueur.
#
# Pour obtenir une clé :
#   1. Connectez-vous avec votre compte Riot sur https://developer.riotgames.com
#   2. Copiez la « Development API Key » affichée sur le tableau de bord.
#   ATTENTION : une clé de développement EXPIRE TOUTES LES 24 HEURES.
#   Il faut alors cliquer sur « Regenerate API Key », la recopier ici
#   et redémarrer le serveur (sinon : « Clé API Riot invalide ou expirée »).
#   Pour un usage durable, demandez une « Personal API Key » (gratuite,
#   via « Register Product » sur le portail) : elle n'expire pas.
RIOT_API_KEY=

# Serveur (plateforme) par défaut des joueurs :
# euw1, eun1, tr1, ru, me1, na1, br1, la1, la2, kr, jp1, oc1, sg2, tw2, vn2
RIOT_PLATFORM=euw1

# Région de routage (account-v1 / match-v5) : europe, americas, asia, sea.
# Laissez vide pour la déduire automatiquement du serveur ci-dessus.
RIOT_REGION=europe

# Nombre de parties récentes analysées par joueur (match-v5).
# RIOT_MATCH_COUNT=20

# --- Stockage ---------------------------------------------------------
# Chemins relatifs = relatifs au dossier web/backend/.
# Base SQLite (joueurs, équipes, compositions, cache des parties).
DATABASE_PATH=data/app.db
# Cache disque des données Data Dragon (liste des champions, version).
CACHE_DIR=data/cache

# --- Data Dragon ------------------------------------------------------
# Langue des noms de champions.
DDRAGON_LOCALE=fr_FR
