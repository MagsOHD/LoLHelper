# Hébergement Apache (OVH). L'appli utilise des URL en « #/... » : aucune réécriture
# n'est nécessaire, à la racine du site comme dans un sous-dossier (www/lolhelper).
Options -Indexes

# Toujours relire index.html et config.js (les autres fichiers ont un nom versionné).
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|config\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Ne jamais servir les fichiers .htaccess / .htpasswd.
<Files ".ht*">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
